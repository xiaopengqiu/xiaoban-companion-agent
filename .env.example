# Copy to .env. Never commit real credentials.
COMPANION_HOST=127.0.0.1
COMPANION_PORT=8765
COMPANION_DB_PATH=data/companion.sqlite3
COMPANION_SCHEDULER_ENABLED=true

# Only for a Python service exposed behind an HTTPS reverse proxy.
# See docs/public-deployment.md. The hosted Worker has its own runtime secrets.
COMPANION_PUBLIC_MODE=false
COMPANION_ALLOWED_HOSTS=
COMPANION_TRUSTED_PROXY_IPS=
COMPANION_AUTH_RATE_WINDOW_SECONDS=60
COMPANION_LOGIN_RATE_LIMIT=10
COMPANION_REGISTER_RATE_LIMIT=3
COMPANION_DEMO_RATE_LIMIT=2
COMPANION_PUBLIC_DEMO_ENABLED=false
COMPANION_PUBLIC_DEMO_MAX_ACCOUNTS=100

# Open Wearables 0.11.0 service, server-only credentials.
OPEN_WEARABLES_URL=http://localhost:8000
OPEN_WEARABLES_API_KEY=
OPEN_WEARABLES_APP_ID=
OPEN_WEARABLES_APP_SECRET=
# Phone-reachable HTTPS base URL when different from the backend's internal URL.
OPEN_WEARABLES_PUBLIC_URL=
OPEN_WEARABLES_WEBHOOK_SECRET=

# Optional OpenAI-compatible chat provider; never required for the local demo.
# Enable individual user consent in Settings before sending personal summaries.
COMPANION_MODEL_BASE_URL=
COMPANION_MODEL_API_KEY=
COMPANION_MODEL=

# Optional Mem0 OSS vector index. Private JSON configuration stays outside Git.
MEM0_ENABLED=false
MEM0_CONFIG_PATH=
MEM0_TELEMETRY=false

# Optional native push: path to a server-only Firebase service account JSON.
FCM_SERVICE_ACCOUNT_FILE=
FCM_PROJECT_ID=
