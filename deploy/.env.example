# Bootstrap writes generated passwords to ignored deploy/.env, preserving existing files.
ENVIRONMENT=production
API_PORT=8000
OW_API_PORT=8000
OW_PORTAL_PORT=3000
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
DB_HOST=db
DB_PORT=5432
DB_NAME=open-wearables
DB_USER=open-wearables
DB_PASSWORD=GENERATE_DB_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_SSL=false
SECRET_KEY=GENERATE_SECRET_KEY
ADMIN_EMAIL=admin@companion.local
ADMIN_PASSWORD=GENERATE_ADMIN_PASSWORD
SENTRY_ENABLED=false
SENTRY_SEND_SENSITIVE_DATA=false
TELEMETRY_ENABLED=false
RAW_PAYLOAD_STORAGE=disabled
SDK_PAYLOAD_S3_OFFLOAD=false
OUTGOING_WEBHOOKS_ENABLED=false
SVIX_SERVER_URL=http://svix-server:8071
# Keep provider credentials unset until you register your own developer apps.
# No SMTP, model key, vendor OAuth or FCM credentials are needed for local demo mode.
